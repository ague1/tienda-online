<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_screen"
    android:fillViewport="true"
    tools:context=".features.profiles.presentation.fragment.AccountFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- ENCABEZADO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/foodstore_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- TARJETA DEL PERFIL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/foodstore_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <!-- TIPO DE CUENTA -->
                <TextView
                    android:id="@+id/accountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mi Cuenta"
                    android:textColor="@color/foodstore_text"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <!-- AVATAR -->
                <TextView
                    android:id="@+id/initials"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/custumer"
                    android:gravity="center"
                    android:text="JD"
                    android:textColor="@color/foodstore_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/fullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="John Doe"
                    android:textColor="@color/foodstore_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <!-- FECHA DE REGISTRO -->
                <TextView
                    android:id="@+id/memberSince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Member since Jan 2024"
                    android:textColor="@color/foodstore_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <!-- SEPARADOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/foodstore_background"/>

                <!-- INFORMACIÓN DE CONTACTO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informacion de Contacto"
                    android:textColor="@color/foodstore_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- CORREO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="@color/foodstore_text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="john.doe@example.com"
                        android:textColor="@color/foodstore_text"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- TELÉFONO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telefono"
                        android:textColor="@color/foodstore_text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="+1 (555) 123-4567"
                        android:textColor="@color/foodstore_text"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- DIRECCIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Direccion"
                        android:textColor="@color/foodstore_text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="123 Main St, New York, NY 10001"
                        android:textColor="@color/foodstore_text"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- BOTONES -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Editar Perfil"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/foodstore_primary"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Configuraciones"
                    android:textColor="@color/foodstore_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/foodstore_surface"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/foodstore_primary"
                    app:strokeWidth="1dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>

