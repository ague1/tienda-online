<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="12dp"
    android:elevation="4dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#F2F7FF">

        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_image_height"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="@string/product_image"/>


        <TextView
            android:id="@+id/txtNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Producto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="por kilo"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Precio normal -->
        <TextView
            android:id="@+id/txtPrecioNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$30.00"
            android:layout_marginBottom="2dp"
            style="@style/ProductNormalPrice" />

        <!-- Precio especial -->
        <TextView
            android:id="@+id/txtPrecioEspecial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$24.00"
            android:visibility="gone"
            style="@style/ProductSpecialPrice"
            tools:visibility="visible" />

        <!-- Botón añadir + contador -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <!-- Añadir al carrito -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnadirCarrito"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="Añadir al carrito"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:backgroundTint="#263963"
                app:cornerRadius="12dp"
                app:icon="@drawable/baseline_shopping_cart_24"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:rippleColor="#40263963" />

            <!-- Control de cantidad -->
            <LinearLayout
                android:id="@+id/layoutContador"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/bg_quantity_container"
                android:padding="2dp">

                <!-- MENOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenos"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="#263963"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="10dp"
                    app:rippleColor="#20263963" />

                <!-- CANTIDAD -->
                <TextView
                    android:id="@+id/txtCantidad"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#263963"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- MAS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#263963"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="10dp"
                    app:rippleColor="#20263963" />

            </LinearLayout>

        </FrameLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>