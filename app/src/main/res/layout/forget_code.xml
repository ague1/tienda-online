<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_screen">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/foodstore_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Nombre de la aplicación -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/foodstore_primary"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Verificacion"
                android:textColor="@color/foodstore_text"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Introduce codigo de verificacion"
                android:textColor="@color/foodstore_text_secondary"
                android:textSize="14sp"/>

            <!-- Código OTP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/code1"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/custumer"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/foodstore_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/code2"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/custumer"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/foodstore_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <EditText android:id="@+id/code3"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/custumer"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/foodstore_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <EditText android:id="@+id/code4"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/custumer"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/foodstore_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout> <!-- Botón -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verifyButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Verificar"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/foodstore_primary"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
